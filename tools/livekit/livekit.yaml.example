# Скопируется в livekit.yaml скриптом ensure_livekit.py. Не кладите секреты в git.
port: 7880
bind_addresses:
  - ""
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50011
  use_external_ip: true
  stun_servers:
    - stun.l.google.com:19302
keys:
  CHANGE_ME_KEY: CHANGE_ME_SECRET
logging:
  level: info
