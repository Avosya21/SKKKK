# LightRAG для карты SKKKK — скопировать в tools/lightrag/.env
# cp .env.example .env

HOST=0.0.0.0
PORT=9621
LIGHTRAG_API_KEY=skkkk-lightrag-change-me

# Изолированное пространство (не смешивать с другими RAG)
WORKSPACE=SKKKK_PROJECT_MAP
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts

# Хранилища по умолчанию — JSON + NetworkX (без Neo4j/Qdrant)
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# --- LLM: Ollama chat (индексация без LM Studio / Gemma) ---
# ollama pull qwen2.5:3b
LLM_BINDING=ollama
LLM_BINDING_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT=600
OLLAMA_LLM_NUM_CTX=8192
EXTRACT_OLLAMA_LLM_THINK=false
KEYWORD_OLLAMA_LLM_THINK=false

MAX_ASYNC=1
MAX_TOKENS=8192

# --- LLM alt: LM Studio (раскомментировать, выключить блок выше) ---
# LLM_BINDING=openai
# LLM_BINDING_HOST=http://host.docker.internal:1234/v1
# LLM_BINDING_API_KEY=lm-studio
# LLM_MODEL=google/gemma-4-31b-qat
# LLM_TIMEOUT=300

MAX_ASYNC=2
MAX_TOKENS=8192

# --- Embeddings: Ollama bge-m3 (CPU, тот же что у SKKKK) ---
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_BINDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BATCH_NUM=16
OLLAMA_EMBEDDING_NUM_CTX=8192

# Логи
LOG_LEVEL=INFO
