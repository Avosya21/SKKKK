# PrimaryAnalitics — HTTPS на :777. :777 отдаёт готовый файл (Chrome к IP часто без SNI).
# Боевой сертификат Caddy добирает на :8443 (тот же IP, HTTP-01 на :8088).

{
	auto_https disable_redirects
	email {$PRIMARY_ANALITICS_ACME_EMAIL}
	http_port {$PRIMARY_ANALITICS_ACME_HTTP_PORT:8088}
	log {
		output file {$PRIMARY_ANALITICS_CADDY_PROC_LOG:D:/Primary_Analitics/data/logs/caddy-proc.log}
		level INFO
	}
	storage file_system {
		root {$PRIMARY_ANALITICS_CADDY_STORAGE:D:/Primary_Analitics/data/caddy}
	}
	cert_issuer acme {$PRIMARY_ANALITICS_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} {
		profile shortlived
		disable_tlsalpn_challenge
	}
	servers {
		protocols h1 h2
	}
}

:{$PRIMARY_ANALITICS_ACME_HTTP_PORT:8088} {
	@not_acme not path /.well-known/acme-challenge/*
	redir @not_acme https://{$PRIMARY_ANALITICS_PUBLIC_HOST}:{$PRIMARY_ANALITICS_HTTPS_PORT:777}{uri}
}

:{$PRIMARY_ANALITICS_HTTPS_PORT:777} {
	log {
		output file {$PRIMARY_ANALITICS_CADDY_LOG:D:/Primary_Analitics/data/logs/caddy.log}
	}
	tls {$PRIMARY_ANALITICS_TLS_CERT} {$PRIMARY_ANALITICS_TLS_KEY}
	handle_path /livekit/* {
		reverse_proxy 127.0.0.1:7880 {
			# Не светим апстрим-стек наружу (было Server: uvicorn/livekit).
			header_down -Server
		}
	}
	handle {
		reverse_proxy 127.0.0.1:{$PRIMARY_ANALITICS_WEB_PORT:1777} {
			# Не светим апстрим-стек наружу (было Server: uvicorn).
			header_down -Server
			transport http {
				response_header_timeout 15m
			}
		}
	}
}

https://{$PRIMARY_ANALITICS_PUBLIC_HOST}:{$PRIMARY_ANALITICS_ACME_TLS_PORT:8443} {
	tls force_automate {
		issuer acme {$PRIMARY_ANALITICS_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	respond "ok" 200
}
