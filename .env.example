# SKKKK local secrets — copy to .env and fill in.
# Never commit .env

SECRET_KEY=change-me
ADMIN_PASSWORD_HASH=
MANAGER_PASSWORD_HASH=
USER_PASSWORD_HASH=

DATABASE_URL=sqlite:///C:/1C_NEW_SKKKK/data/app.db
DATA_DIR=C:\1C_NEW_SKKKK\data

# Optional: ffmpeg/ffprobe if not in PATH (default fallback: C:\ffmpeg-8.0-full_build\bin)
# FFMPEG_DIR=C:\ffmpeg-8.0-full_build\bin

# OCR: UB-Mannheim tesseract.exe + rus/eng in tools/tesseract/tessdata
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_DIR=C:\1C_NEW_SKKKK\tools\tesseract\tessdata

# Портал только loopback. Снаружи — Caddy на SKKKK_HTTPS_PORT.
WEB_HOST=127.0.0.1
WEB_PORT=1777
WEB_PUBLIC_URL=https://203.0.113.10:777

# --- HTTPS / публичный доступ (Caddy, scripts\install_caddy.ps1) ---
# Белый IP или домен, на который Let's Encrypt выпишет сертификат.
# Сертификат на голый IP живёт 160 часов, Caddy продлевает сам — машина должна быть онлайн.
SKKKK_PUBLIC_HOST=203.0.113.10
SKKKK_HTTPS_PORT=777
SKKKK_ACME_EMAIL=
# Боевой CA. Staging Chrome не доверяет («Не защищено»).
SKKKK_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Роутер: внешний :80 → этот порт (не на 777). Иначе HTTP-01 и https://…:777 не уживутся.
SKKKK_ACME_HTTP_PORT=8088
# Выпуск/продление Let's Encrypt. main при старте смотрит файл :777 и перевыпускает, если его нет или он недействителен.
SKKKK_ACME_TLS_PORT=8443
SKKKK_TLS_RENEW_HOURS=48
SKKKK_TLS_ISSUE_TIMEOUT_SEC=120
# После первого выпуска Caddy кладёт cert/key сюда (путь зависит от CA). Пустые — main берёт этот каталог сам.
# SKKKK_TLS_CERT=C:/1C_NEW_SKKKK/data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/203.0.113.10/203.0.113.10.crt
# SKKKK_TLS_KEY=C:/1C_NEW_SKKKK/data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/203.0.113.10/203.0.113.10.key

LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Должна совпадать с model_key профиля tools/lmstudio/qwen-profile.json (окно, 2 потока, KV q8_0, MTP) — иначе модель не загрузится
LMSTUDIO_MODEL=swift-qwen3.8-27b-uncensored-dynamic-mtp
LMSTUDIO_API_KEY=lm-studio
# Модель загружает и выгружает портал (services/llm_keeper.py): выгрузка после простоя без задач и чата, TTL LM Studio — страховка
LMSTUDIO_IDLE_UNLOAD_SEC=300
LMSTUDIO_LOAD_TTL_SEC=1800
# false — модель выгружается на время GPU-шагов ASR (Parakeet, GigaAM), чат ждёт; true — только если карта вмещает обе
LMSTUDIO_KEEP_DURING_ASR=false
# Доля общего окна модели под чат (токены); фоновый запрос сверх остатка ждёт ответа чата
LMSTUDIO_CHAT_TOKEN_BUDGET=22000

# LLM: lmstudio (Gemma локально) или cursor (Cursor API)
LLM_PROVIDER=lmstudio
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# local — bridge на этой машине; cloud — VM Cursor (нужен CURSOR_CLOUD_REPO)
CURSOR_RUNTIME=local
CURSOR_CLOUD_REPO=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_NUM_GPU=0

HF_TOKEN=

# ASR-контейнеры (docker compose в asr/)
WHISPER_URL=http://127.0.0.1:18101
GIGAAM_URL=http://127.0.0.1:18102
TONE_URL=http://127.0.0.1:18103
# Диаризация: nemotron3 (до 8 спикеров) | sortformer4 (откат, до 4)
DIAR_MODEL=nemotron3
GIGAAM_API_KEY=gam_change_me

TELEGRAM_BOT_TOKEN=

MAX_UPLOAD_BYTES=2147483648

# Пауза после лабораторной стенограммы: имена спикеров, затем knowledge
# VOICE_GATE_BEFORE_ASR=false — сразу transcript_ready без окна имён
VOICE_GATE_BEFORE_ASR=true
# strict — ждать, пока все голоса названы; soft — знания сразу, неизвестные голоса называются позже (всё пересчитается само)
VOICE_GATE_MODE=soft
# Автопроверка локальной моделью: off | shadow (вердикты без последствий) | live (применяются)
AUTO_REVIEW_MODE=live
# Каждое N-е авторешение дополнительно показывается человеку (контрольная выборка); 0 — выключена, человеку только спорное
AUTO_REVIEW_AUDIT_EVERY=0
# Сущностей на один вызов LLM при проверке
AUTO_REVIEW_BATCH=5
# Автопринятие голоса: сходство не ниже MIN и отрыв от второго кандидата не меньше MARGIN
VOICE_AUTO_ACCEPT_MIN=0.85
VOICE_AUTO_ACCEPT_MARGIN=0.10
# Размер чанка для resumable-загрузки (4 МиБ)
UPLOAD_CHUNK_SIZE=4194304
SIMILARITY_THRESHOLD=0.82
SEARCH_MIN_SCORE=0.35
# Выжимка проекта на каждом N-м созвоне — только без автопроверки (off); с ней — за проверками, одна на партию
TZ_REBUILD_EVERY_N=3
DRY_RUN=0
JWT_EXPIRE_MINUTES=43200
# Список допущенных логинов (по строке). Регистр не важен. Читается при каждом входе.
# LOGIN_ALLOWLIST_PATH=C:\1C_NEW_SKKKK\Login_up.txt
# Личный пароль после пароля роли: required — обязателен (по умолчанию); off — только аварийный откат.
# Нужен перезапуск.
PERSONAL_PASSWORD=required
# Хеши личных паролей — отдельная база (Argon2id). Сброс — пункт 7 меню запуска или scripts/personal_password.py
# По умолчанию — DATA_DIR\credentials.db. CREDENTIALS_DB_PATH=C:\1C_NEW_SKKKK\data\credentials.db
# PERSONAL_PASSWORD_MIN_LEN=10
# Компании для карточки пользователя: «Название | Исполнитель» (образец — Companies.example.txt). Читается каждый раз.
# COMPANIES_PATH=C:\1C_NEW_SKKKK\Companies.txt
# Как модель называет компанию-исполнителя в поле «исполнитель» задачи (через запятую, без регистра):
# такой исполнитель общий, при склейке задач его заменяет конкретный человек
EXECUTOR_ALIASES=

# --- Meeting Mind (гостевой портал /m/{token}) ---
# URL для браузера — через Caddy: wss://<IP>:777/livekit
# Ключи пишет tools/livekit/ensure_livekit.py
LIVEKIT_URL=wss://203.0.113.10:777/livekit
LIVEKIT_NODE_IP=203.0.113.10
LIVEKIT_LAN_IP=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Живой звук комнаты (не ASR). Шумодав — DFN3 в браузере говорящего (0 — шумоподавление браузера).
# MEETING_VOICE_SERVER — рекордер голоса tools/livekit/voice_cleaner.py (пишет сырые дорожки, звук не чистит).
MEETING_VOICE_SERVER=1
MEETING_VOICE_DFN3=1
MEETING_VOICE_LOUDNESS=1
# Сырые дорожки спикеров: data/meetings/{room_name}/tracks + manifest.json
MEETING_RECORD=1
MEETING_SCREEN_RECORD=1
MEETING_SCREEN_FPS=1
MEETING_SCREEN_MAX_W=1920
MEETING_SCREEN_HEIGHT=1080
MEETING_SCREEN_BITRATE=5M
MEETING_SCREEN_VISION=0
MEETING_FRAMES_MAX=60
# Порог речи на дорожке (RMS окон 1 с). Ниже — silent, без ASR.
MEETING_SPEECH_MIN_SEC=2
MEETING_SPEECH_RMS_MIN=0.01
# Пороги проверок шкалы созвона (секунды).
MEETING_CHECK_OK_SEC=0.30
MEETING_CHECK_WARN_SEC=0.70
MEETING_HEAD_LOSS_WARN_SEC=3
MEETING_GAP_MUTE_WINDOW_SEC=1
MEETING_RMS_TIE_RATIO=1.15
LIVEKIT_RTC_INTERNAL=ws://127.0.0.1:7880

# Память решений: off | shadow | live по умолчанию (проект включает своей настройкой decision_memory); auto_live — сам переход shadow -> live
DECISION_MEMORY_MODE=off
DECISION_MEMORY_AUTO_LIVE=true
